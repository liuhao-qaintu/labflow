# 先在MySQL中创建数据库和专用账号；真实.env仅保存在服务端。
DATABASE_URL=
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
# 模型名按服务商实际支持填写；只有使用AI和重建向量时才调用模型API。
LLM_BASE_URL=
LLM_MODEL=
SILICONFLOW_API_KEY=
# 本地调试文档显式打开，公开部署保持关闭。
ENABLE_API_DOCS=false
# 业务管理员不自动成为维护人员。初始化后按实际管理员ID配置收件人。
DEVELOPER_USER_IDS=[]
# PASSWORD_RECOVERY_ADMIN_ID=初始化输出的管理员ID
# 管理员核验重置时使用的初始密码；配置与交付策略见docs/OPERATIONS.md。
RESET_INITIAL_PASSWORD=
